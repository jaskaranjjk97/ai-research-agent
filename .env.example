
# Application
APP_NAME=ai-research-agent
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# Search provider
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Optional shared search API key (if supported by another provider)
SEARCH_API_KEY=

# Provider timeouts and retries
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
SEARCH_TIMEOUT_SECONDS=30
RESEARCH_REQUEST_TIMEOUT_SECONDS=180

# Research limits
MAX_RESEARCH_ITERATIONS=3
MAX_TOOL_CALLS=20
MAX_SOURCES=30
MAX_SEARCH_RESULTS=10

# API
API_HOST=0.0.0.0
API_PORT=8000
